[deployment]
build = ["sh", "-c", "npm i -g pnpm --force || true && PNPM=$(which pnpm 2>/dev/null || echo $HOME/.npm-global/bin/pnpm) && mkdir -p $(dirname $PNPM) $HOME/.local/bin node_modules/.bin && printf \"#!/bin/sh\\nexec node /home/runner/workspace/artifacts/api-server/dist/index.mjs\\n\" > $PNPM && printf \"#!/bin/sh\\nexec node /home/runner/workspace/artifacts/api-server/dist/index.mjs\\n\" > $HOME/.local/bin/pnpm && printf \"#!/bin/sh\\nexec node /home/runner/workspace/artifacts/api-server/dist/index.mjs\\n\" > node_modules/.bin/pnpm && chmod 755 $PNPM $HOME/.local/bin/pnpm node_modules/.bin/pnpm && echo PNPM=$PNPM && ls -l $PNPM && cat $PNPM && echo DONE"]
run = ["pnpm"]
deploymentTarget = "cloudrun"
