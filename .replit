modules = ["nodejs-20"]
[deployment]
build = ["sh", "-c", "cd artifacts/mockup-sandbox && pnpm run build"]
run = ["sh", "-c", "cd artifacts/mockup-sandbox && pnpm exec vite preview --host 0.0.0.0 --port 8080"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081
