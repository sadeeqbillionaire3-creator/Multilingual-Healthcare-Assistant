modules = ["nodejs-20"]

[nix]
packages = ["pnpm"]

[deployment]
build = ["sh", "-c", "pnpm --filter @workspace/healthcare-assistant run build && pnpm --filter @workspace/api-server run build"]
run = ["sh", "-c", "PORT=8080 NODE_ENV=production node --enable-source-maps artifacts/api-server/dist/index.mjs"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20372
externalPort = 3002
